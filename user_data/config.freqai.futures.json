{
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "identifier": "macd_gated_ml",
    "feature_parameters": {
      "include_timeframes": [
        "15m",
        "1h"
      ],
      "include_corr_pairlist": [
        "BTC/USDT:USDT",
        "ETH/USDT:USDT"
      ],
      "label_period_candles": 16,
      "include_shifted_candles": 2,
      "DI_threshold": 1.0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_learn_features": false,
      "indicator_periods_candles": [
        10,
        20
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 200,
      "max_depth": 4,
      "learning_rate": 0.05,
      "n_jobs": -1
    }
  }
}
