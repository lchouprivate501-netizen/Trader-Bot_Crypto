# Copy to ea.env (git-ignored) and fill in. Freqtrade reads FREQTRADE__SECTION__KEY overrides.
# Keep dry-run until the deployment checklist is done.
FREQTRADE__DRY_RUN=true
FREQTRADE__DRY_RUN_WALLET=10000

# Exchange API key: trade permission only (spot + USDT-M futures for the ETH / SOL futures EAs),
# withdrawals OFF, IP whitelist ON. Futures EAs use isolated margin and set their own leverage (1-3x).
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Optional: cap the capital one bot may use when several bots share an account.
# FREQTRADE__AVAILABLE_CAPITAL=3000

# Optional Telegram notifications / control (/status, /stopentry, /forceexit all).
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=

# REST API used by the live guard (ea-guard service). Reachable only inside the compose network
# (no ports are published). Use long random values.
FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__LISTEN_IP_ADDRESS=0.0.0.0
FREQTRADE__API_SERVER__LISTEN_PORT=8080
FREQTRADE__API_SERVER__USERNAME=ea-guard
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=
EA_GUARD_API_USER=ea-guard
EA_GUARD_API_PASSWORD=
# Optional guard alerts to Telegram (only DEGRADED / HALT / ALERT are sent)
# EA_GUARD_TELEGRAM_TOKEN=
# EA_GUARD_TELEGRAM_CHAT_ID=
